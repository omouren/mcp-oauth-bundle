{
    "name": "omouren/mcp-oauth-bundle",
    "description": "MCP OAuth 2.1 for Symfony (CIMD, RFC 8414/9728, DCR deprecated)",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": ["symfony", "bundle", "mcp", "oauth", "oauth2"],
    "authors": [
        {
            "name": "Olivier Mouren",
            "email": "mouren.olivier@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "league/oauth2-server-bundle": "^0.10 || ^1.2",
        "symfony/event-dispatcher": "^7.3|^8.0",
        "symfony/framework-bundle": "^7.3|^8.0",
        "symfony/http-client": "^7.3|^8.0",
        "symfony/http-foundation": "^7.3|^8.0",
        "symfony/http-kernel": "^7.3|^8.0",
        "symfony/mcp-bundle": "^0.13 || ^0.14",
        "symfony/routing": "^7.3|^8.0",
        "symfony/security-bundle": "^7.3|^8.0",
        "symfony/twig-bundle": "^7.3|^8.0",
        "symfony/yaml": "^7.3|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.3|^8.0",
        "symfony/css-selector": "^7.3|^8.0",
        "symfony/phpunit-bridge": "^7.3|^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Default League persistence (oauth2_* tables)",
        "doctrine/orm": "Default League persistence (oauth2_* tables)"
    },
    "conflict": {
        "symfony/framework-bundle": "<7.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Omouren\\McpOauthBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omouren\\McpOauthBundle\\Tests\\": "tests/"
        }
    }
}
